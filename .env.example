# ==============================================================================
# ERP SYSTEM ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env` in the root of the project.
# 2. Replace all placeholder values with your production/local secrets.
# ==============================================================================

# Core Settings
SECRET_KEY=your_secret_key_here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# --------------------------------------------------------------------------
# Database — Option A: Render-managed PostgreSQL (recommended for production)
# --------------------------------------------------------------------------
# Render provides this automatically when you create a PostgreSQL service.
DATABASE_URL=

# --------------------------------------------------------------------------
# Database — Option B: Individual credentials (Supabase / self-hosted)
# --------------------------------------------------------------------------
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432

# Tally Integration
TALLY_URL=http://localhost:9000

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# CSRF Trusted Origins (comma-separated, for production custom domains)
CSRF_TRUSTED_ORIGINS=

# AI Integration (Multi-Model Architecture)
GROQ_API_KEY=your_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Django Settings Module (set to config.settings.dev for local development)
DJANGO_SETTINGS_MODULE=config.settings.prod
