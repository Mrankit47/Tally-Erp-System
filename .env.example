# ==============================================================================
# ERP SYSTEM ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env` in the root of the project.
# 2. Replace all placeholder values with your production/local secrets.
# ==============================================================================

# Core Settings
SECRET_KEY=your_secret_key_here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL / Supabase)
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432

# Tally Integration
TALLY_URL=http://localhost:9000
